# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal Sandbox (developer.paypal.com -> My Apps & Credentials -> Sandbox -> Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# AI provider — Groq (free tier, no credit card needed: console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=3000
