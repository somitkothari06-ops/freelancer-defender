# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal Sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Comma-separated PayPal sign-in emails allowed to view and act on merchant sandbox cases.
# Keep empty to show only seeded demo cases. Never allow all signed-in users.
LIVE_ACTION_EMAILS=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Only needed for `npm run paypal:seed` (developer.paypal.com -> Sandbox -> Accounts -> your Personal account)
PAYPAL_SANDBOX_BUYER_EMAIL=

# AI provider: Groq (console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=3000
# Optional persistent storage root for entered cases and uploaded evidence.
# On Render, this must be an attached disk mount on a paid web service.
DATA_DIR=
