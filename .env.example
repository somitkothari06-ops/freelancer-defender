# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal Sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Only needed for `npm run paypal:seed` (developer.paypal.com -> Sandbox -> Accounts -> your Personal account)
PAYPAL_SANDBOX_BUYER_EMAIL=

# AI provider: Groq (console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

PORT=3000
