{
  "name": "freelancer-defender",
  "version": "0.1.0",
  "description": "An AI agent that defends freelancers against payment reversals, built on PayPal's Disputes API.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/eval.js",
    "run-one": "node scripts/run-one.js",
    "paypal:check": "node scripts/paypal-check.js",
    "paypal:seed": "node scripts/paypal-seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "16.4.5",
    "express": "4.21.2"
  }
}
